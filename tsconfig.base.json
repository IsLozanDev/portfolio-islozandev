{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "paths": {
      "@vitrina/shared/contracts": [
        "./libs/shared/contracts/src/index.ts"
      ],
      "@vitrina/shared/util": [
        "./libs/shared/util/src/index.ts"
      ],
      "@vitrina/plataforma/kernel": [
        "./libs/plataforma/kernel/src/index.ts"
      ],
      "@vitrina/plataforma/kernel-infra": [
        "./libs/plataforma/kernel-infra/src/index.ts"
      ],
      "@vitrina/plataforma/org": [
        "./libs/plataforma/org/src/index.ts"
      ],
      "@vitrina-fixtures/cfg": [
        "./tools/boundaries-test/fixtures/cfg/src/index.ts"
      ],
      "@vitrina-fixtures/aud": [
        "./tools/boundaries-test/fixtures/aud/src/index.ts"
      ],
      "@vitrina-fixtures/evt": [
        "./tools/boundaries-test/fixtures/evt/src/index.ts"
      ],
      "@vitrina-fixtures/psi": [
        "./tools/boundaries-test/fixtures/psi/src/index.ts"
      ]
    }
  }
}
