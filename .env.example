# Environment variables for the Vitrina application v2.1.1.1.

NODE_ENV=development
PORT=3000
# Supabase dev por el transaction pooler (6543). No hay PostgreSQL local.
DATABASE_URL=postgres://postgres.<project_ref>:<clave>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379
SUPABASE_URL=https://<project_ref>.supabase.co
# Publishable key: la usan los frontends y la api para el ingreso con contraseña y MFA (spec 18b).
SUPABASE_PUBLISHABLE_KEY=
# Antigüedad máxima del MFA (segundos) para rutas con @RequiereMfa (TR-RN-009).
SEG_MFA_MAX_EDAD_SEG=900
# Secret key de Supabase (Admin API: invitaciones; Storage de archivos, spec 33). Solo apps/api y apps/worker; nunca en el repo.
SUPABASE_SECRET_KEY=
# Google OAuth (spec 14): solo para Supabase local (supabase/config.toml). En dev y prod van en el panel.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Página de aceptación de invitaciones (spec 14); debe estar en la allowlist de redirect de Supabase.
SEG_URL_INVITACION=http://127.0.0.1:4200/auth/invitacion
# Vigencia del token propio de invitación (horas).
SEG_INVITACION_HORAS=72
# Migraciones contra Supabase (solo db:up:remoto y db:down:remoto): conexión directa o session pooler, puerto 5432.
DATABASE_MIGRATION_URL=
# Solo CI: servidor PostgreSQL 16 donde las pruebas de integración crean bases temporales.
# Sin esta variable esas pruebas se saltan. Nunca apuntarla a Supabase. ojo.
TEST_DATABASE_URL=
# Solo CI: con CLAMAV_HOST definido corren además las pruebas contra clamd real (spec 34); sin él se saltan.
# Relay del outbox (apps/worker, spec 11). La api solo usa EVT_INTENTOS, EVT_BACKOFF_MS y EVT_BACKOFF_MAX_MS.
EVT_INTERVALO_MS=1000
# Margen de seguridad del relay en segundos (TR-RN-035).
EVT_MARGEN_SEG=2
EVT_LOTE=500
EVT_REBARRIDO_SEG=60
EVT_VENTANA_SEG=300
EVT_INTENTOS=8
EVT_BACKOFF_MS=5000
EVT_BACKOFF_MAX_MS=600000
EVT_CONCURRENCIA=5
# Vencimiento de accesos de soporte (apps/worker, spec 18), en milisegundos.
SOPORTE_VENCIMIENTO_CADA_MS=60000
# Verificación diaria de la cadena de auditoría (apps/worker, spec 20b): cron de 5 campos en America/Lima.
AUD_VERIFICACION_CRON=30 3 * * *
# Archivos (spec 33): bucket privado de Supabase Storage (api y worker) y limpieza diaria de cargas sin confirmar (worker).
ARC_BUCKET=archivos
ARC_LIMPIEZA_CRON=45 3 * * *
# Antivirus de archivos (spec 34), solo worker. ARC_ANTIVIRUS: eicar | clamav (eicar por defecto; en production solo clamav).
# eicar solo detecta la cadena de prueba EICAR. clamav habla con clamd por TCP dentro de la red privada.
ARC_ANTIVIRUS=eicar
# Host de clamd. Obligatorio con clamav. En local no hay ClamAV; en el CI es localhost.
# CLAMAV_HOST=
CLAMAV_PORT=3310
# Espera de la respuesta de clamd y de la conexión TCP, en milisegundos.
CLAMAV_TIMEOUT_MS=60000
CLAMAV_CONEXION_TIMEOUT_MS=5000
# Reencolado de los archivos que llevan más de 15 minutos EN_ANALISIS (worker): cron de 5 campos en America/Lima.
ARC_REENCOLADO_CRON=*/5 * * * *

# Alta de tenant (spec 12): código del tenant operador, el único que da de alta tenants.
ORG_TENANT_OPERADOR=plataforma
# Solo para pnpm plataforma:sembrar: RUC de la empresa del tenant operador (11 dígitos con verificador SUNAT).
ORG_OPERADOR_RUC=

# CORS (spec 17c): orígenes exactos separados por coma, p. ej. https://admin.<dominio>,https://consola.<dominio>.
# Vacío: sin CORS (en local las apps usan el proxy /v1, mismo origen).
ORIGENES_PERMITIDOS=

# Observabilidad (spec 21), api y worker. APP_ENV: local | test | staging | production.
APP_ENV=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=
# Sal del hash de documentos en logs (TR-RNF-111), mínimo 32 caracteres. Obligatoria en staging y production.
OBS_SAL_DOCUMENTO=
# OpenTelemetry (spec 21). Sin endpoint no se exporta nada. El SDK lee también OTEL_EXPORTER_OTLP_HEADERS
# (Authorization=Basic ..., secreto), OTEL_TRACES_SAMPLER y OTEL_TRACES_SAMPLER_ARG. service.name lo pone cada app.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
# Identidad (spec 28), solo api. IDN_PROVEEDOR: falso | decolecta (falso por defecto; en production solo decolecta).
IDN_PROVEEDOR=
# Token de Decolecta (secreto, regla 9). Obligatorio con decolecta.
IDN_DECOLECTA_TOKEN=sk_21817.0KPm5uc4gEVDh3LVGbhN6Iq962mMCMvZ
# Sentry: solo errores (5xx de la api y trabajos fallidos del worker). Vacío: no se inicia.
SENTRY_DSN=

# Bóveda de secretos (spec 41), api y worker con la MISMA lista. Secretas (regla 9): nunca en el repo.
# SEC_CLAVES_MAESTRAS: versiones de la clave maestra como 1:<base64 de 32 bytes>;2:<base64 de 32 bytes>.
# SEC_CLAVE_ACTIVA: versión con la que se envuelven las claves nuevas. Obligatorias en production; sin ellas
# (local, test) la app arranca y la bóveda lanza BovedaNoConfiguradaError al usarse.
# Rotación: pnpm secretos:clave <versión nueva>; guardarla en el gestor de contraseñas y en el panel de despliegue;
# agregarla a la lista en api y worker y desplegar; activarla en SEC_CLAVE_ACTIVA y desplegar los dos;
# pnpm secretos:reenvolver; pnpm secretos:reenvolver --verificar debe dar 0; recién entonces quitar la versión vieja.
# Detalle en docs/ops/supabase-ambientes.md (8. Secretos).
SEC_CLAVES_MAESTRAS=
SEC_CLAVE_ACTIVA=

# Notificaciones por correo (spec 42), api y worker. Secretas (regla 9): nunca en el repo. Obligatorias en production;
# sin ellas (local, test) la app arranca, el envío falla con PROVEEDOR_NO_CONFIGURADO y el webhook responde 503.
# RESEND_API_KEY: API key de TR-NOT, distinta de la del SMTP de Auth. RESEND_WEBHOOK_SECRET: signing secret (whsec_...)
# del webhook /v1/notificaciones/webhooks/resend. NOT_REMITENTE: "Nombre <correo@dominio>"; sin dominio verificado,
# onboarding@resend.dev (solo entrega al dueño de la cuenta). NOT_SAL_DESTINO: sal del hash del correo, 32+ caracteres,
# la misma en api y worker. NOT_CORREO_OPERACION (worker, opcional): destino del aviso aud.integridad.rota (spec 44);
# vacía, el aviso se omite con un log. Detalle en docs/ops/supabase-ambientes.md (18. Notificaciones).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NOT_REMITENTE=
NOT_SAL_DESTINO=
NOT_CORREO_OPERACION=

# Facturación electrónica (spec 50), api y worker. FE_SIMULADO_PERMITIDO: el proveedor SIMULADO se puede configurar y
# probar (true solo en dev y CI). FE_PRODUCCION_PERMITIDA: un emisor puede pasar a PRODUCCION (true solo en prod).
# Por defecto false. Detalle por ambiente en docs/ops/supabase-ambientes.md (19. Facturación electrónica).
FE_SIMULADO_PERMITIDO=true
FE_PRODUCCION_PERMITIDA=false
