# Environment variables for the Vitrina application v2.1.1.1.

NODE_ENV=development
PORT=3000
# Supabase dev por el transaction pooler (6543). No hay PostgreSQL local.
DATABASE_URL=postgres://postgres.<project_ref>:<clave>@aws-1-us-west-2.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Antigüedad máxima del MFA (segundos) para rutas con @RequiereMfa (TR-RN-009).
SEG_MFA_MAX_EDAD_SEG=900
# Secret key de Supabase (Admin API: invitaciones). Solo apps/api; nunca en el repo.
SUPABASE_SECRET_KEY=
# Página de aceptación de invitaciones (spec 14); debe estar en la allowlist de redirect de Supabase.
SEG_URL_INVITACION=http://127.0.0.1:4200/auth/invitacion
# Vigencia del token propio de invitación (horas).
SEG_INVITACION_HORAS=72
# Migraciones contra Supabase (solo db:up:remoto y db:down:remoto): conexión directa o session pooler, puerto 5432.
DATABASE_MIGRATION_URL=
# Solo CI: servidor PostgreSQL 16 donde las pruebas de integración crean bases temporales.
# Sin esta variable esas pruebas se saltan. Nunca apuntarla a Supabase. ojo.
TEST_DATABASE_URL=
