{
  "name": "vitrina",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "prepare": "husky",
    "dev:infra": "docker compose up -d --wait",
    "db:up": "node --env-file-if-exists=.env tools/migrar/cli.mjs up",
    "db:down": "node --env-file-if-exists=.env tools/migrar/cli.mjs down",
    "db:up:remoto": "node --env-file-if-exists=.env tools/migrar/cli.mjs up db --remoto",
    "db:down:remoto": "node --env-file-if-exists=.env tools/migrar/cli.mjs down db --remoto",
    "db:up:supabase": "node --env-file-if-exists=.env tools/migrar/cli.mjs up supabase/migrations",
    "db:down:supabase": "node --env-file-if-exists=.env tools/migrar/cli.mjs down supabase/migrations",
    "db:up:supabase:remoto": "node --env-file-if-exists=.env tools/migrar/cli.mjs up supabase/migrations --remoto",
    "db:down:supabase:remoto": "node --env-file-if-exists=.env tools/migrar/cli.mjs down supabase/migrations --remoto",
    "manifiesto:aplicar": "nx build api && node --env-file-if-exists=.env --enable-source-maps apps/api/dist/cli/aplicar-manifiesto.js",
    "manifiesto:aplicar:remoto": "nx build api && node --env-file-if-exists=.env --enable-source-maps apps/api/dist/cli/aplicar-manifiesto.js --remoto",
    "plataforma:sembrar": "nx build api && node --env-file-if-exists=.env --enable-source-maps apps/api/dist/cli/sembrar-plataforma.js",
    "vencimientos:ejecutar": "nx build worker && node --env-file-if-exists=.env --enable-source-maps apps/worker/dist/cli/ejecutar-vencimientos.js",
    "vencimientos:ejecutar:remoto": "nx build worker && node --env-file-if-exists=.env --enable-source-maps apps/worker/dist/cli/ejecutar-vencimientos.js --remoto",
    "plataforma:sembrar:remoto": "nx build api && node --env-file-if-exists=.env --enable-source-maps apps/api/dist/cli/sembrar-plataforma.js --remoto"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.28",
    "@angular-devkit/schematics": "~21.2.28",
    "@angular/build": "~21.2.28",
    "@angular/compiler": "~21.2.25",
    "@angular/compiler-cli": "~21.2.25",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "12.2.0",
    "@nx/angular": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/web": "23.3.0",
    "@schematics/angular": "~21.2.28",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "4.1.12",
    "angular-eslint": "^21.2.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jsdom": "27.1.0",
    "lint-staged": "^17.6.0",
    "ng-packagr": "~21.2.7",
    "nx": "23.3.0",
    "pg": "^8.23.1",
    "postcss": "8.5.31",
    "supabase": "^2.121.0",
    "supertest": "^7.3.1",
    "tailwindcss": "4.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@angular/cdk": "~21.2.14",
    "@angular/common": "~21.2.25",
    "@angular/core": "~21.2.25",
    "@angular/forms": "~21.2.25",
    "@angular/material": "~21.2.14",
    "@angular/platform-browser": "~21.2.25",
    "@angular/router": "~21.2.25",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "ajv": "^8.20.0",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sweetalert2": "11.26.25",
    "tslib": "2.8.1",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "{apps,libs,tools}/**/*.ts": "eslint --fix"
  }
}
