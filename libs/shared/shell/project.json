{
  "name": "shared-shell",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/shell/src",
  "prefix": "vit",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/shared/shell/ng-package.json",
        "tsConfig": "libs/shared/shell/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/shell/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "coverageInclude": [
          "libs/shared/shell/src/lib/**/*.ts"
        ]
      }
    }
  }
}
