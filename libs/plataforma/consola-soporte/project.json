{
  "name": "plataforma-consola-soporte",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/plataforma/consola-soporte/src",
  "prefix": "vit",
  "projectType": "library",
  "tags": [
    "scope:plataforma",
    "type:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/plataforma/consola-soporte/ng-package.json",
        "tsConfig": "libs/plataforma/consola-soporte/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/plataforma/consola-soporte/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    }
  }
}
