{
  "name": "org",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/plataforma/org/src",
  "projectType": "library",
  "tags": ["scope:plataforma", "type:backend", "comp:org"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -b libs/plataforma/org/tsconfig.json", "cwd": "{workspaceRoot}" },
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "node --experimental-vm-modules node_modules/jest/bin/jest.js -c libs/plataforma/org/jest.config.mjs", "cwd": "{workspaceRoot}" }
    }
  }
}
